# InsAcc Enterprise Environment Variable Template
# File: docs/enterprise/configs/env/.env.example

# Environment Mode: 'development', 'staging', 'production'
NODE_ENV=production

# Node Server Port
PORT=3000

# Base Currency Code
DEFAULT_CURRENCY=AED

# Target Database Connection URL [To Be Implemented]
DATABASE_URL="postgresql://insacc_user:SecurePassword123@localhost:5432/insacc_db?schema=public&sslmode=require"

# JWT Authentication Secret & Token Expiry [To Be Implemented]
JWT_SECRET="e9b2c8f4a1d7e3f6b9c2a5d8e1f4b7c0a3d6e9f2b5c8a1d4e7f0b3c6a9d2e5f8"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Log Level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# File Upload Storage Directory
UPLOAD_DIR=/var/insacc/uploads
MAX_FILE_SIZE_MB=25
